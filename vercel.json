
{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "miniapp/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/search",
      "dest": "/api/index.py"
    },
    {
      "src": "/webhook",
      "dest": "/api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "/miniapp/$1"
    }
  ]
}
